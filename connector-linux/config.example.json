{
  "gateway_url": "wss://gateway.example.com/connect",
  "device_id": "laptop-1",
  "platform": "linux",
  "token_file": "/etc/agentic-connector/token",
  "work_dir": "/var/lib/agentic-connector/work",
  "allow_commands": [
    "ls",
    "cat",
    "grep",
    "find",
    "head",
    "tail",
    "wc",
    "df",
    "du",
    "uname",
    "uptime",
    "ps",
    "systemctl",
    "journalctl",
    "git",
    "docker"
  ],
  "deny_commands": ["rm", "dd", "mkfs", "shutdown", "reboot", "sudo", "su"],
  "allow_shell": false,
  "max_output_bytes": 200000,
  "command_timeout_seconds": 60,
  "read_only": false,
  "audit_file": "/var/lib/agentic-connector/audit.jsonl",
  "log_level": "info"
}
