{
  "name": "@openharness/gateway",
  "version": "0.1.0",
  "description": "Device gateway: devices dial out over WebSocket; the orchestrator reaches each one as a Streamable HTTP MCP server.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "openharness-gateway": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "cli": "node dist/cli.js",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@openharness/connector-core": "file:../connector-core",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@node-rs/argon2": "2.2.1",
    "express": "5.1.0",
    "mongodb": "6.21.0",
    "ws": "8.21.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.5",
    "@types/node": "22.19.0",
    "@types/ws": "8.18.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
