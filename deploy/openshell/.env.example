# OpenHarness on an OpenShell host. Copy to .env and fill in.

# --- Harness (the OpenHarness server, usually on another network) ---------------------------------------------
# Where the device gateway listens. With the self-signed TLS front: wss://<server>:8443/connect
OPENHARNESS_GATEWAY_URL=wss://harness.example.com:8443/connect
# The OpenShell managed machine you created in the studio (Inventory → Add resource → OpenShell managed machine).
OPENHARNESS_DEVICE_ID=openshell-1
OPENHARNESS_TOKEN=dv_paste_the_token_shown_once
# Self-signed harness? Copy its ca.crt into ./certs and keep this; delete it for a publicly trusted certificate.
OPENHARNESS_CA_FILE=/certs/ca.crt
# Development only: allow ws:// instead of wss://.
OPENHARNESS_ALLOW_INSECURE=false

# --- OpenShell ------------------------------------------------------------------------------------------------
OPENSHELL_VERSION=0.1.2
OPENSHELL_PORT=8080
# Host directory for the OpenShell state, database and PKI (bind-mounted at the same path inside the gateway).
OPENSHELL_STATE_DIR=/var/lib/openshell
OPENSHELL_WORKSPACE=default
OPENSHELL_TELEMETRY_ENABLED=false

# --- What the edge lets any caller do (agents through the machine's allow-list, the console through the API) -
OPENSHELL_ALLOW_POLICY_CHANGES=true
OPENSHELL_ALLOW_SANDBOX_LIFECYCLE=true
OPENSHELL_ALLOW_EXEC=true
# Comma-separated image references or prefixes create_sandbox and executors may use; empty allows any.
OPENSHELL_ALLOWED_IMAGES=
OPENSHELL_MAX_SANDBOXES=20
OPENSHELL_MANAGE_ALL_SANDBOXES=true

# --- Executors: sandboxes that run the OpenHarness connector under an OpenShell policy ------------------------
# Image containing /usr/local/bin/openharness-connector (built by ./build-images.sh or pulled from your registry).
EXECUTOR_IMAGE=openharness-connector:local
EDGE_IMAGE=openharness-edge:local
# Extra destinations every executor may reach, as host:port[:access[:protocol[:enforcement]]].
EXECUTOR_ALLOWED_HOSTS=
# Optional bootstrap executor: enroll a Linux machine in the studio and put its id and token here; the edge
# launches it at start. Executors can also be launched from the OpenShell console at any time.
OPENHARNESS_EXECUTOR_DEVICE_ID=
OPENHARNESS_EXECUTOR_TOKEN=
# Executors dial the same harness gateway unless this is set (for example a different route from sandboxes).
OPENHARNESS_EXECUTOR_GATEWAY_URL=
LOG_LEVEL=info
