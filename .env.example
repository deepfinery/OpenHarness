# ./start.sh generates unique random secrets into .env. Never commit that file.
PUBLIC_URL=http://localhost:8088
STUDIO_BIND=127.0.0.1
STUDIO_PORT=8088
MONGO_PASSWORD=
RABBITMQ_PASSWORD=
WEAVIATE_API_KEY=
ENCRYPTION_KEY=
SETUP_TOKEN=
WORKER_CONCURRENCY=2
MAX_ACTIVE_RUNS=20
MAX_UPLOAD_MB=20
# Explicitly add trusted private MCP/model hostnames, comma-separated.
ALLOWED_PRIVATE_HOSTS=host.docker.internal,ollama
ALLOW_PRIVATE_URLS=false
# Set to 1 only when the application is behind exactly one trusted reverse proxy.
TRUST_PROXY=0

# Optional: require Inbox approval for selected machine tools.
GATEWAY_APPROVAL_PROVIDER=noop
GATEWAY_APPROVAL_TOOLS=
